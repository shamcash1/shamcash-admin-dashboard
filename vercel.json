{
  "rewrites": [
    {
      "source": "/sub/:username",
      "destination": "/api/index.js"
    },
    {
      "source": "/pac/:username",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|pac/|sub/).*)",
      "destination": "/index.html"
    }
  ]
}
